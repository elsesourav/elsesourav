# ==============================================================================
# ElseSourav V2 Environment Variables Template
# ==============================================================================
# Copy this file to '.env.local' or '.env' for local development.
# Do NOT put real production secrets in this file or commit them to Git.
# ==============================================================================

# Application Environment
NODE_ENV=development

# Canonical Public Site Origin
NEXT_PUBLIC_SITE_URL=https://elsesourav.com

# Supabase Public Credentials (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection Strings (Prisma ORM)
DATABASE_URL=postgresql://postgres:password@localhost:5432/elsesourav?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/elsesourav?schema=public

# Cloudinary Media Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=elsesourav
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ADMIN_PORTAL=true
