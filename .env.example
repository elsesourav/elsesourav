# ==============================================================================
# ElseSourav V2 — Environment Variables Reference & Template
# ==============================================================================
# Copy this file to '.env.local' or '.env' for local development.
# WARNING: NEVER commit real production secrets, keys, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Expected values: 'development' | 'test' | 'staging' | 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. CANONICAL PUBLIC SITE ORIGIN (Client-safe)
# ------------------------------------------------------------------------------
# Base URL for canonical tags, OpenGraph URLs, and metadata generation
NEXT_PUBLIC_SITE_URL=https://elsesourav.com

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION & IDENTITY (Client-safe public keys)
# ------------------------------------------------------------------------------
# Public Supabase project API endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client-side Supabase authentication
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVER-ONLY PRIVILEGED CREDENTIALS (Server-only — Never expose to browser)
# ------------------------------------------------------------------------------
# High-privilege service role key used only in Server Actions / admin endpoints
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role-key

# ------------------------------------------------------------------------------
# 5. POSTGRESQL & PRISMA ORM CONNECTION (Server-only)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (e.g. Supabase Transaction Pooler port 6543)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection string for schema migrations and CLI operations (port 5432)
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA ASSET MANAGEMENT
# ------------------------------------------------------------------------------
# Public Cloudinary cloud delivery identifier (Client-safe)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=elsesourav

# Server-only API credentials used for generating secure signed upload tickets
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 7. FEATURE FLAGS & TOGGLES (Client-safe)
# ------------------------------------------------------------------------------
# Enable or disable client-side observability and performance telemetry
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Enable or disable administrative navigation portal links
NEXT_PUBLIC_ENABLE_ADMIN_PORTAL=true
