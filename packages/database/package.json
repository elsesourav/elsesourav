{
  "name": "@elsesourav/database",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/seed.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@elsesourav/config": "workspace:*",
    "@elsesourav/media": "workspace:*",
    "@elsesourav/types": "workspace:*",
    "@elsesourav/utils": "workspace:*",
    "@elsesourav/validation": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.10.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
