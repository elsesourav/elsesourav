nticated_experience_e2e_test_createauthmock", "callee": "ok", "is_member_call": false, "source_file": "/Users/sourav/Developer/WEB/elsesourav/src/tests/authenticated-experience-e2e.test.tsx", "source_location": "L200"}, {"caller_nid": "tests_authenticated_experience_e2e_test_createauthmock", "callee": "fn", "is_member_call": true, "source_file": "/Users/sourav/Developer/WEB/elsesourav/src/tests/authenticated-experience-e2e.test.tsx", "source_location": "L201"}, {"caller_nid": "tests_authenticated_experience_e2e_test_renderwithproviders", "callee": "render", "is_member_call": false, "source_file": "/Users/sourav/Developer/WEB/elsesourav/src/tests/authenticated-experience-e2e.test.tsx", "source_location": "L208"}, {"caller_nid": "tests_authenticated_experience_e2e_test_renderwithproviders", "callee": "</AuthContext.Provider>\n        </ToastProvider>\n      </ThemeProvider>\n    );\n  };\n\n  it('Steps 1\u20135: Unauthenticated visitor browsing apps and attempting save is safely routed to login', async () => {\n    renderWithProviders('/apps/codeflow-ide', {\n      authUser: null,\n      user: null,\n      role: 'user',\n      isAuthenticated: false,\n    });\n\n    // Verify App detail page rendered\n    expect(\n      await screen.findByRole('heading', { level: 1, name: /CodeFlow IDE/i }, { timeout: 3000 })\n    ).toBeInTheDocument();\n\n    // Verify unauthenticated user clicking save directs to login\n    const saveBtn = await screen.findByRole('button', { name: /Save CodeFlow IDE to library/i });\n    expect(saveBtn).toBeInTheDocument();\n    await userEvent.click(saveBtn);\n\n    // Redirects safely to login\n    await waitFor(() => {\n      expect(\n        screen.getByRole('heading', { level: 1, name: /Sign in to ElseSourav/i })\n      ).toBeInTheDocument();\n    });\n  });\n\n  it('Steps 6\u20139: Authenticated user reaches /library and sees their saved software & metrics', async () => {\n    renderWithProviders('/library');\n\n    // Step 8: User reaches library\n    expect(\n      await screen.findByRole('heading', { level: 1, name: /My Software Library/i })\n    ).toBeInTheDocument();\n    expect(screen.getByText(/Welcome back, Sourav Mukherjee/i)).toBeInTheDocument();\n    expect(screen.getByText(/Verified/i)).toBeInTheDocument();\n\n    // Step 9: User sees saved app card\n    expect(await screen.findByText('CodeFlow IDE')).toBeInTheDocument();\n    expect(screen.getByText('Saved Applications')).toBeInTheDocument();\n  })", "is_member_call": false, "source_file": "/Users/sourav/Developer/WEB/elsesourav/src/tests/authenticated-experience-e2e.test.tsx", "source_location": "L215"}, {"caller_nid": "tests_authenticated_experience_e2e_test_renderwithproviders", "callee": "</ToastProvider>\n      </ThemeProvider>\n    );\n  };\n\n  it('Steps 1\u20135: Unauthenticated visitor browsing apps and attempting save is safely routed to login', async () => {\n    renderWithProviders('/apps/codeflow-ide', {\n      authUser: null,\n      user: null,\n      role: 'user',\n      isAuthenticated: false,\n    });\n\n    // Verify App detail page rendered\n    expect(\n      await screen.findByRole('heading', { level: 1, name: /CodeFlow IDE/i }, { timeout: 3000 })\n    ).toBeInTheDocument();\n\n    // Verify unauthenticated user clicking save directs to login\n    const saveBtn = await screen.findByRole('button', { name: /Save CodeFlow IDE to library/i });\n    expect(saveBtn).toBeInTheDocument();\n    await userEvent.click(saveBtn);\n\n    // Redirects safely to login\n    await waitFor(() => {\n      expect(\n        screen.getByRole('heading', { level: 1, name: /Sign in to ElseSourav/i })\n      ).toBeInTheDocument();\n    });\n  })", "is_member_call": false, "source_file": "/Users/sourav/Developer/WEB/elsesourav/src/tests/authenticated-experience-e2e.test.tsx", "source_location": "L216"}, {"caller_nid": "tests_authenticated_experience_e2e_test_renderwithproviders", "callee": "it", "is_member_call": false, "source_file": "/Users/soura