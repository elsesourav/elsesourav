{
  "name": "@elsesourav/v1-reference",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npx vite-node scripts/generate-sitemap.ts",
    "build:sitemap": "npx vite-node scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/utils src/services src/repositories src/schemas src/config",
    "test:components": "vitest run src/components",
    "test:integration": "vitest run src/tests/*integration* src/tests/*workflow*",
    "test:e2e": "vitest run src/tests/*e2e*",
    "test:security": "vitest run src/tests/security-threat-scenarios.test.ts src/tests/firestore-rules.test.ts",
    "test:a11y": "vitest run src/tests/accessibility-audit.test.tsx",
    "test:rules": "vitest run src/tests/firestore-rules.test.ts",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "mobile:sync": "cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "db:seed": "npx vite-node scripts/seed-firestore.ts",
    "db:validate": "npx vite-node scripts/validate-database.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "firebase": "^12.18.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
